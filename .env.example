# Variables d'environnement APPLITAG — frontend Vite
# Copier ce fichier en .env.local, .env.development ou .env.production
# selon l'environnement cible.

# Mode applicatif (obligatoire) — valeurs : production | demo | development
VITE_APP_MODE=demo

# URL de base de l'API (optionnel — defaut : API Railway production)
# En production, définir explicitement pour éviter toute ambiguïté.
VITE_API_URL=https://applitag-api-production.up.railway.app
